# =============================================================================
# .env.example — Modelo de configuração local (SEM segredos — commitável)
# =============================================================================
# Copie para .env e preencha com suas chaves:  cp .env.example .env
# As variáveis usam o prefixo IA_LAB_ (ver ai/settings.py).
#
# ⚠️  NUNCA coloque chaves reais neste arquivo — elas vão para o .env (gitignored)
# =============================================================================

# ── Provider primário do chat ────────────────────────────────────────────────
# ollama → local, custo zero (padrão do código — AGENTS.md, regra nº 1)
# gemini → Google AI Studio (free tier, sem cartão)
# groq   → console.groq.com (free tier, sem cartão)
# bitnet → servidor 1-bit local em http://localhost:8080
IA_LAB_PRIMARY_PROVIDER=ollama

# ── Chave Gemini — https://aistudio.google.com/apikey ───────────────────────
# Só necessária se IA_LAB_PRIMARY_PROVIDER=gemini (ou como alternativa gratuita)
# IA_LAB_GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Modelo Gemini (free tier):
#   gemini-3.1-flash-lite  → mais rápido (~1,5s) e respostas completas (padrão)
#   gemini-3.5-flash       → mais novo, mas tem "thinking" que corta respostas
# IA_LAB_GEMINI_MODEL=gemini-3.1-flash-lite

# ── Alternativas gratuitas (opcionais) ──────────────────────────────────────
# IA_LAB_GROQ_API_KEY=COLE_SUA_CHAVE_AQUI
# IA_LAB_GROQ_MODEL=llama-3.3-70b-versatile

# ── Local (Ollama / BitNet) ─────────────────────────────────────────────────
# O modelo precisa existir em `ollama list`; confira com:
#   ollama list && ollama show glm4:latest
IA_LAB_OLLAMA_MODEL=glm4:latest
IA_LAB_OLLAMA_BASE_URL=http://localhost:11434

# BitNet (LLM 1-bit em CPU) — container opcional do profile `llm`
IA_LAB_BITNET_BASE_URL=http://localhost:8080/v1
IA_LAB_BITNET_MODEL=qwen3:8b

# RAG exige Qdrant rodando localmente — desligue se não usar.
# Com false, /api/health/ready mostra qdrant="skipped" e não exige o serviço.
IA_LAB_RAG_ENABLED=false

# ── Coraci (persistência) ───────────────────────────────────────────────────
# Caminhos relativos são resolvidos a partir do diretório de execução.
# Os dois apps são independentes: o FastAPI (/api/v2/chat) e o Flask legado
# (Aplicativo_Coraci/app.py) usam bancos separados.
# IA_LAB_CORACI_DB=coraci.db
# IA_LAB_CORACI_CONFIG=Aplicativo_Coraci/config.json
# IA_LAB_CORACI_FLASK_DB=Aplicativo_Coraci/coraci.db
# IA_LAB_CORACI_FLASK_CONFIG=Aplicativo_Coraci/config.json
# Chave do provider do Coraci Flask (precede o campo api_key do config.json):
# CORACI_API_KEY=

# ── Ambiente / observabilidade ─────────────────────────────────────────────
# production endurece validações (falha no boot com segredo JWT default)
IA_LAB_ENVIRONMENT=development
IA_LAB_LOG_LEVEL=INFO

# ── Segurança da API ─────────────────────────────────────────────────────────
# Token exigido no header X-API-Key pelos routers /api/v2 (chat, education,
# openvino). Gere com: openssl rand -hex 32
# Vazio = autenticação DESABILITADA (dev local / suíte de testes).
# IA_LAB_API_TOKEN=

# SSRF: com false, POST /api/v2/config/test recusa hosts privados, loopback e
# link-local. Metadata de cloud (169.254.169.254) é sempre bloqueada.
# Default true = local-first (Ollama/LM Studio + portal na LAN escolar).
# IA_LAB_ALLOW_PRIVATE_API_HOSTS=false

# ── Materiais educacionais persistentes ────────────────────────────────────
# Padrão: education.db no diretório de execução. Em containers, use um volume.
# Caminho absoluto: sqlite:////caminho/persistente/education.db
# IA_LAB_EDUCATION_DB_URL=sqlite:///education.db
# Apenas para dados temporários: sqlite:///:memory:
# Configuração, verificação e backup: EDUCATION_STORAGE.md
