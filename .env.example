# ═══════════════════════════════════════════════════════════════════════════
#  IA-Lab Unified — Configuração de Ambiente
# ═══════════════════════════════════════════════════════════════════════════
#  Copie para .env e preencha os valores:
#
#    cp .env.example .env
#
#  Todas as variáveis usam o prefixo IA_LAB_ e são carregadas
#  automaticamente pelo pydantic-settings.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
#  Provedor Primário
# ═══════════════════════════════════════════════════════════════════════════

# Provedor padrão para tarefas de IA.
# Valores possíveis: openai, claude, gemini, groq, glm, perplexity, ollama, bitnet
IA_LAB_PRIMARY_PROVIDER=openai

# Provedor local (execução sem API key)
IA_LAB_LOCAL_PROVIDER=ollama

# ═══════════════════════════════════════════════════════════════════════════
#  OpenAI
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_OPENAI_API_KEY=
IA_LAB_OPENAI_BASE_URL=https://api.openai.com/v1
IA_LAB_OPENAI_MODEL=gpt-4o

# ═══════════════════════════════════════════════════════════════════════════
#  Anthropic Claude
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_CLAUDE_API_KEY=
IA_LAB_CLAUDE_BASE_URL=https://api.anthropic.com/v1
IA_LAB_CLAUDE_MODEL=claude-sonnet-4-20250514

# ═══════════════════════════════════════════════════════════════════════════
#  Google Gemini
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_GEMINI_API_KEY=
IA_LAB_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IA_LAB_GEMINI_MODEL=gemini-2.5-flash-001

# ═══════════════════════════════════════════════════════════════════════════
#  Groq
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_GROQ_API_KEY=
IA_LAB_GROQ_BASE_URL=https://api.groq.com/openai/v1
IA_LAB_GROQ_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════════════════════════
#  GLM (Zhipu)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_GLM_API_KEY=
IA_LAB_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IA_LAB_GLM_MODEL=glm-4-plus

# ═══════════════════════════════════════════════════════════════════════════
#  Perplexity
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_PERPLEXITY_API_KEY=
IA_LAB_PERPLEXITY_BASE_URL=https://api.perplexity.ai
IA_LAB_PERPLEXITY_MODEL=sonar-pro

# ═══════════════════════════════════════════════════════════════════════════
#  Ollama (local — sem API key)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_OLLAMA_BASE_URL=http://localhost:11434
IA_LAB_OLLAMA_MODEL=qwen2.5:7b

# ═══════════════════════════════════════════════════════════════════════════
#  Freebuff (deepseek-v4-flash)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_FREEBUFF_API_KEY=
IA_LAB_FREEBUFF_MODEL=deepseek-v4-flash

# ═══════════════════════════════════════════════════════════════════════════
#  BitNet (LLM 1-bit local)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_BITNET_BASE_URL=http://localhost:8080/v1
IA_LAB_BITNET_MODEL=qwen3:8b

# ═══════════════════════════════════════════════════════════════════════════
#  RAG — Qdrant Vector Database
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_RAG_ENABLED=true
IA_LAB_QDRANT_HOST=localhost
IA_LAB_QDRANT_PORT=6333
IA_LAB_QDRANT_COLLECTION=ia-lab-docs

# ═══════════════════════════════════════════════════════════════════════════
#  Redis — Cache + Rate Limiting
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_REDIS_HOST=localhost

# ═══════════════════════════════════════════════════════════════════════════
#  Educação (HistóriaIA)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_EDUCATION_DB_URL=sqlite+aiosqlite:///education.db
IA_LAB_EDUCATION_REDIS_URL=redis://localhost:6379/0
IA_LAB_EDUCATION_JWT_SECRET=change-me-in-production
IA_LAB_EDUCATION_JWT_ALGORITHM=HS256

# ═══════════════════════════════════════════════════════════════════════════
#  OpenVINO (opcional)
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_OPENVINO_ENABLED=false
IA_LAB_OPENVINO_MODEL_PATH=models/openvino
IA_LAB_OPENVINO_DEVICE=CPU

# ═══════════════════════════════════════════════════════════════════════════
#  Coraci Chat
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_CORACI_DB_PATH=coraci.db
IA_LAB_CORACI_MAX_HISTORY=100

# ═══════════════════════════════════════════════════════════════════════════
#  Geral
# ═══════════════════════════════════════════════════════════════════════════

IA_LAB_LOG_LEVEL=INFO
IA_LAB_HEALTH_CHECK_TIMEOUT=5.0

# ═══════════════════════════════════════════════════════════════════════════
#  Variáveis legadas (mantidas para compatibilidade)
# ═══════════════════════════════════════════════════════════════════════════
#  Estas variáveis SEM prefixo IA_LAB_ são lidas por módulos
#  específicos que ainda não foram migrados.

# HistóriaIA (projeto original)
SECRET_KEY=dev-secret-key
DATABASE_URL=sqlite+aiosqlite:///education.db
REDIS_URL=redis://localhost:6379/0

# Coraci (Flask legado)
FLASK_SECRET_KEY=troque-isto-em-producao
FLASK_DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════
#  Brave Search API — busca na web para agentes/MCP (brave_search_mcp.py)
#  Obtenha chave gratuita em https://brave.com/search/api/
# ═══════════════════════════════════════════════════════════════════════════

BRAVE_API_KEY=
BRAVE_COUNTRY=br
BRAVE_LANG=pt
