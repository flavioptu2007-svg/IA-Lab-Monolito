# =============================================================================
# .env.example — Modelo de configuração local (SEM segredos — commitável)
# =============================================================================
# Copie para .env e preencha com suas chaves:  cp .env.example .env
# As variáveis usam o prefixo IA_LAB_ (ver ai/settings.py).
#
# ⚠️  NUNCA coloque chaves reais neste arquivo — elas vão para o .env (gitignored)
# =============================================================================

# ── Provider primário do chat ────────────────────────────────────────────────
# gemini → Google AI Studio (grátis, sem cartão) — recomendado
# groq   → console.groq.com (grátis, sem cartão)
# ollama → local (só funciona na LAN)
IA_LAB_PRIMARY_PROVIDER=gemini

# ── Chave Gemini — https://aistudio.google.com/apikey ───────────────────────
IA_LAB_GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Modelo Gemini (free tier):
#   gemini-3.1-flash-lite  → mais rápido (~1,5s) e respostas completas (padrão)
#   gemini-3.5-flash       → mais novo, mas tem "thinking" que corta respostas
IA_LAB_GEMINI_MODEL=gemini-3.1-flash-lite

# ── Alternativas gratuitas (opcionais) ──────────────────────────────────────
# IA_LAB_GROQ_API_KEY=COLE_SUA_CHAVE_AQUI
# IA_LAB_GROQ_MODEL=llama-3.3-70b-versatile

# ── Local ────────────────────────────────────────────────────────────────────
# RAG exige Qdrant rodando localmente — desligue se não usar
IA_LAB_RAG_ENABLED=false

# ── Segurança da API ─────────────────────────────────────────────────────────
# Token exigido no header X-API-Key pelos routers /api/v2 (chat, education,
# openvino). Gere com: openssl rand -hex 32
# Vazio = autenticação DESABILITADA (dev local / suíte de testes).
# IA_LAB_API_TOKEN=

# SSRF: com false, POST /api/v2/config/test recusa hosts privados, loopback e
# link-local. Metadata de cloud (169.254.169.254) é sempre bloqueada.
# Default true = local-first (Ollama/LM Studio + portal na LAN escolar).
# IA_LAB_ALLOW_PRIVATE_API_HOSTS=false
