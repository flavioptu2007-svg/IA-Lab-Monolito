# IA-Lab Enterprise - Configuração
# Copie este arquivo para .env e preencha suas chaves

# --- Provedor Primário ---
IA_LAB_PRIMARY_PROVIDER=openai
IA_LAB_LOCAL_PROVIDER=ollama

# --- GLM (Zhipu) ---
IA_LAB_GLM_API_KEY=
IA_LAB_GLM_MODEL=glm-4-plus

# --- Ollama (Local) ---
IA_LAB_OLLAMA_MODEL=qwen2.5:7b
IA_LAB_OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI ---
IA_LAB_OPENAI_API_KEY=
IA_LAB_OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
IA_LAB_CLAUDE_API_KEY=
IA_LAB_CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
IA_LAB_GEMINI_API_KEY=
IA_LAB_GEMINI_MODEL=gemini-2.5-flash-001

# --- Groq ---
IA_LAB_GROQ_API_KEY=
IA_LAB_GROQ_MODEL=llama-3.3-70b-versatile

# --- Perplexity ---
IA_LAB_PERPLEXITY_API_KEY=
IA_LAB_PERPLEXITY_MODEL=sonar-pro

# --- RAG / Qdrant ---
IA_LAB_RAG_ENABLED=true
IA_LAB_QDRANT_HOST=localhost
IA_LAB_QDRANT_PORT=6333

# --- Geral ---
IA_LAB_LOG_LEVEL=INFO
