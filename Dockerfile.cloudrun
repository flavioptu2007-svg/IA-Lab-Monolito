# =============================================================================
# IA-Lab API — Dockerfile para Google Cloud Run
# =============================================================================
# Versão enxuta do monolito para deploy na nuvem:
#   - Instala apenas o CORE (sem OpenVINO, speechbrain, dev tools)
#   - Copia todos os módulos importados pelo server (incl. src/, leituraia/)
#   - RAG (Qdrant) fica desabilitado via env IA_LAB_RAG_ENABLED=false
#
# Build:
#   docker build -f Dockerfile.cloudrun -t gcr.io/jogos-5f131/ia-lab-api:latest .
# =============================================================================

# ── Stage 1: Builder ────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Ferramentas de build para compilar wheels com extensão C (ex.: webrtcvad)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml requirements.txt ./

# Instala o pacote (core + extra education p/ leituraia: jose/passlib/argon2)
# Sem extras pesados (OpenVINO, speechbrain, dev tools)
RUN pip install --no-cache-dir build wheel && \
    pip install --no-cache-dir --prefix=/install '.[education]'

# ── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM python:3.12-slim

LABEL org.opencontainers.image.title="IA-Lab API (Cloud Run)"
LABEL org.opencontainers.image.description="Monolito FastAPI — chat, áudio e educação (deploy nuvem)"
LABEL org.opencontainers.image.version="2.0.0"

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Dependências de sistema (mínimas)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    ca-certificates \
    curl \
    espeak \
    espeak-ng \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Usuário não-root
RUN addgroup --system --gid 1001 app && \
    adduser --system --uid 1001 --ingroup app --no-create-home app

WORKDIR /app

# Pacotes instalados do builder
COPY --from=builder /install /usr/local

# Código da aplicação — todos os módulos importados pelo server
COPY ai/ ./ai/
COPY api/ ./api/
COPY web/ ./web/
COPY src/ ./src/
COPY leituraia/ ./leituraia/
COPY Aplicativo_Coraci/ ./Aplicativo_Coraci/

# Diretórios de dados (coraci.db etc.)
RUN mkdir -p /data /tmp/ia-lab-audio && \
    chown -R app:app /app /data /tmp/ia-lab-audio

USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8080/api/health || exit 1

# Cloud Run injeta PORT=8080 — usa ela se definida
CMD ["sh", "-c", "uvicorn api.server:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers"]
